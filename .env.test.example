# Apenas projeto de teste, com migrations aplicadas. Não versionar .env.test.local.
# .env.local deve ter URL, chave pública e APP_URL do mesmo projeto.
# A e B: contas confirmadas e exclusivas para testes, em negócios distintos.
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
# Conta ainda não existente; com confirmação habilitada, confirme o email recebido
# em até dez minutos enquanto check:ui aguarda. Para a UI, use esta mesma conta em A.
# Use novo email a cada rodada do check:ui completo.
TEST_SIGNUP_EMAIL=
TEST_SIGNUP_PASSWORD=
# Opcional: conta dedicada à UI, preservando A/B para isolamento.
# Use a mesma conta de TEST_SIGNUP, sem negócio antes da regressão completa.
TEST_UI_EMAIL=
TEST_UI_PASSWORD=
# Apenas para fixture Auth de desenvolvimento importada e já confirmada.
# Não altera configuração de confirmação do projeto; não testa entrega SMTP.
TEST_SIGNUP_PRECONFIRMED=0
